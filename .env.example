# voice-core node. Copy to .env, set NODE_TOKEN, then:  docker compose --env-file .env up -d
# One token for everything (gateway + services); generate e.g. `openssl rand -hex 32`. Hex only (it goes into
# the gateway config verbatim).
NODE_TOKEN=change-me
# The single port the coordinator talks to (open it to the coordinator only, e.g. a VPN or firewall rule).
GATEWAY_PORT=8790
# Images (GHCR; while the packages are private: `docker login ghcr.io` with a read:packages token)
REGISTRY=ghcr.io/voxarbor
VOICE_CORE_TAG=v0.10.0   # a voice-core release (root VERSION); every image carries it
# Threads / CPU limits per service: size to the machine (defaults fit a 4-core / 16 GB PC). When several
# services work at once they share cores; the sum of threads should stay near the core count.
STT_THREADS=4
TTS_THREADS=2
TRANSLATE_THREADS=2
DIARIZE_THREADS=2
STT_CPUS=4
TTS_CPUS=4
TRANSLATE_CPUS=4
DIARIZE_CPUS=4
# Whisper model (downloaded once by the init service)
STT_MODEL=deepdml/faster-whisper-large-v3-turbo-ct2
TTS_ENGINES=holos
TRANSLATE_NLLB=0
# Optional web UI (compose.ui.yaml)
UI_PORT=8774
TTS_UI_PASSWORD=
# Optional YouTube fetch service (metadata, subtitles, audio from this node's IP): uncomment to enable.
# Cookies (optional): put a Netscape cookies.txt into the fetch-config volume (/config/cookies.txt).
#COMPOSE_PROFILES=fetch
#FETCH_QUEUE_MAX=4
#FETCH_CPUS=1
#YTDLP_PROXY=
# GPU node (NVIDIA): STT + TTS on the GPU. Pin it here so plain `docker compose` commands and updates keep CUDA:
#COMPOSE_FILE=compose.yaml:compose.gpu.yaml
# Optional overrides:
#STT_GPU_IMAGE=ghcr.io/speaches-ai/speaches:0.8.3-cuda-12.6.3
#STT_GPU_COMPUTE_TYPE=float16
#TTS_GPU_QUEUE_MAX=16
# Outbound link to a coordinator (docs/connect.md): the node dials out, no open port needed. Set both, start the
# stack; after the first start NODE_JOIN_CODE is used up and can be removed.
#COORDINATOR_URL=https://coordinator.example
#NODE_JOIN_CODE=
#NODE_NAME=
#CONNECT_MAX_STREAMS=16
